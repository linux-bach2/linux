// SPDX-License-Identifier: GPL-2.0-only
/*
 * Huawei MediaPad M5 lite 10 (BAH2-W19, "bach2"). Bring-up DT, derived from hi6250-huawei-agassi2.dts.
 * Booted through the bach2 boot shim (the bootloader's DTB is replaced, so nothing here is fixed up by it).
 */
/dts-v1/;

#include "hi6250.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Huawei MediaPad M5 lite 10 (bach2)";
	compatible = "huawei,bach2", "hisilicon,hi6250";
	chassis-type = "tablet";

	aliases {
		/* dw_mmc-k3 uses mshc, independently of the MMC core's mmc alias. */
		mshc2 = &dwmmc2;
		mmc2 = &dwmmc2;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "hisilicon,hi1102-pwrseq";
		clocks = <&pmu_ctrl HI6250_CLK_PMU32KB>;
		clock-names = "ext_clock";
		reset-gpios = <&gpio4 3 GPIO_ACTIVE_LOW>;
		xldo-gpios = <&gpio11 3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default", "power-prepare";
		pinctrl-0 = <&wifi_enable_pin &wifi_uart_normal &wifi_uart_config>;
		pinctrl-1 = <&wifi_enable_pin &wifi_uart_prepare &wifi_uart_config>;
	};

	wifi_vmmc: regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "wifi-vmmc";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
	};

	wifi_vqmmc: regulator-wifi-io {
		compatible = "regulator-fixed";
		regulator-name = "wifi-io-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/*
	 * Volume keys. Stock: hisi_gpio_key, gpio-keyup = GPIO 201, gpio-keydown = GPIO 202
	 * (= gpio25 lines 1, 2), pressed = low (hisi_gpio_key.c), 15 ms debounce timer.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_key_pins>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpio25 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
		};

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpio25 2 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
		};
	};

	/*
	 * Stock ponkey@b1 under hisilicon,hisi-pmic: PMIC IRQ status 0x1b0 bits 7/6 (press/release);
	 * PMIC summary IRQ on gpio23 line 7 (stock gpios = <&gpio@fff0c000 7 0>), level low.
	 */
	pmic-powerkey {
		compatible = "hisilicon,hi6250-pmic-powerkey";
		hisilicon,pmic-syscon = <&pmu_ctrl>;
		interrupts-extended = <&gpio23 7 IRQ_TYPE_LEVEL_LOW>;
	};

	/* /sys/class/backlight/backlight: starts in the bootloader's state, capped by lcd_bl_led. */
	backlight: backlight {
		compatible = "led-backlight";
		leds = <&lcd_bl_led>;
	};

	chosen {
		bootargs = "console=tty0 loglevel=8 ignore_loglevel printk.time=1";

		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "framebuffer0";

		/* The bootloader leaves the DSS scanning out its logo buffer (stock DT: logo-buffer @ 0x5d000000). */
		framebuffer0: framebuffer@5d000000 {
			compatible = "simple-framebuffer";
			reg = <0 0x5d000000 0 (1200 * 1920 * 4)>;
			width = <1200>;
			height = <1920>;
			stride = <(1200 * 4)>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	reserved-memory {
		/* Bootloader fills this in at runtime: ddr-training2@0 -> 0x87b00000 (live DT, status ok, no-map);
		 * the vendor kernel's /proc/iomem shows the matching 32 KiB hole. */
		ddr_training2: memory@87b00000 {
			reg = <0 0x87b00000 0 0x8000>;
			no-map;
		};

		logo_buffer: memory@5d000000 {
			reg = <0 0x5d000000 0 0x3000000>;
			no-map;
		};

		/* Same region and layout as the stock kernel (pstore-mem 0x34800000, 1 MiB),
		 * so the vendor kernel can read this kernel's console after a reboot. */
		ramoops@34800000 {
			compatible = "ramoops";
			reg = <0x0 0x34800000 0x0 0x100000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			ftrace-size = <0x0>;
			pmsg-size = <0x20000>;
			ecc-size = <0x0>;
		};
	};

	/* Live DT handed to the vendor kernel (/proc/device-tree, 2026-11-23): two banks split at 2 GiB */
	memory@400000 {
		device_type = "memory";
		reg = <0x00 0x00400000 0x00 0x7fc00000>,
		      <0x00 0x80000000 0x00 0x40000000>;
	};

	soc {
		gpio4: gpio@e8a0f000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0 0xe8a0f000 0 0x1000>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			clocks = <&crg_ctrl HI6250_PCLK_GPIO4>, <&ao_ctrl HI6250_APB_PCLK>;
			clock-names = "pclk_gpio4", "apb_pclk";
		};

		gpio11: gpio@e8a16000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0 0xe8a16000 0 0x1000>;
			interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			clocks = <&crg_ctrl HI6250_PCLK_GPIO11>, <&ao_ctrl HI6250_APB_PCLK>;
			clock-names = "pclk_gpio11", "apb_pclk";
		};

		dwmmc2: mmc@ff37d000 {
			compatible = "hisilicon,hi6250-dw-mshc";
			reg = <0 0xff37d000 0 0x1000>;
			interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI6250_CLK_SDIO0>, <&crg_ctrl HI6250_HCLK_SDIO0>;
			clock-names = "ciu", "biu";
			resets = <&crg_rst 0x90 19>;
			reset-names = "reset";
			pinctrl-names = "default";
			pinctrl-0 = <&wifi_sdio_pins &wifi_sdio_config>;
			mmc-pwrseq = <&wifi_pwrseq>;
			vmmc-supply = <&wifi_vmmc>;
			vqmmc-supply = <&wifi_vqmmc>;
			bus-width = <4>;
			max-frequency = <25000000>;
			fifo-depth = <0x100>;
			non-removable;
			no-mmc;
			no-sd;
			no-1-8-v;
			cap-sdio-irq;
			keep-power-in-suspend;
			status = "okay";
		};

		pmic: pmic@fff34000 {
			compatible = "hisilicon,hi6421v530-pmic";
			reg = <0x0 0xfff34000 0x0 0x1000>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		/*
		 * Stock i2c@FDF0D000 (alias i2c4; i2c-2 on the vendor kernel): DesignWare, SPI 82, clock
		 * clk_i2c4 (CRG 0x20 bit 27), reset CRG 0x78/0x7c bit 27. 100 kHz against an assumed
		 * 120 MHz ref (clk-hi6250.c): SCL is never faster than requested unless the real ref
		 * exceeds 120 MHz.
		 */
		i2c4: i2c@fdf0d000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfdf0d000 0x0 0x1000>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI6250_CLK_I2C4>;
			resets = <&crg_rst 0x78 27>;
			clock-frequency = <100000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c4_pins>;
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * Stock: huawei,hw_ktz8864 / huawei,hw_lm36274 @0x11, run by lcdkit's common
			 * backlight-IC driver as "hw_lm36274" (huawei,lcd_panel lcd-bl-ic-name).
			 * Brightness: 11 bits, 0x04[2:0] (LSB) + 0x05 (MSB); stock enable 0x08 = 0x1f.
			 * Linux writes only BL_EN (when it differs from 0x1f) and the brightness registers.
			 * LCD bias (0x09-0x0e) and current settings (0x02/0x03/0x10/0x11) stay as the
			 * bootloader left them: there is no regulators node and REGULATOR_LM363X is off.
			 */
			led-controller@11 {
				compatible = "ti,lm36274";
				reg = <0x11>;

				backlight {
					compatible = "ti,lm36274-backlight";

					lcd_bl_led: led {
						label = "white:backlight";
						led-sources = <0 1 2 3>;
						/*
						 * Stock ceiling: hisifb blmax 7582 (hw,lcdkit-panel-blmax
						 * = 0x1d9e) -> bl_lvl_map() -> code 1958 of 2047. Stock
						 * everyday hisifb level 3032 -> code 1657.
						 */
						max-brightness = <1958>;
					};
				};
			};
		};
	};
};

&pmx0 {
	wifi_enable_pin: wifi-enable-pin {
		pinctrl-single,pins = <0x80 0>;
	};
	wifi_sdio_pins: wifi-sdio-pins {
		pinctrl-single,pins = <0xe8 1 0xec 1 0xf0 1 0xf4 1 0xf8 1 0xfc 1>;
	};
	wifi_uart_normal: wifi-uart-normal {
		pinctrl-single,pins = <0x15c 1 0x160 1 0x164 1>;
	};
	wifi_uart_prepare: wifi-uart-prepare {
		pinctrl-single,pins = <0x15c 0 0x160 0 0x164 0>;
	};
};

/* Inputs and backlight */
&pmx0 {
	/* Stock gpio037/gpio038_pmx_func: function 1 = I2C4 SCL/SDA */
	i2c4_pins: i2c4-pins {
		pinctrl-single,pins = <0x88 1 0x8c 1>;
	};
};

&pmx1 {
	/* Stock gpio201/gpio202_pmx_func: function 0 = GPIO */
	vol_key_pins: vol-key-pins {
		pinctrl-single,pins = <0x58 0 0x5c 0>;
	};
};

&pmx2 {
	status = "okay";
	pinctrl-single,function-mask = <0x7f>;
	wifi_sdio_config: wifi-sdio-config {
		/* Stock: CLK 8 mA/no pull, CMD + DAT[3:0] 4 mA/pull-up. */
		pinctrl-single,pins = <0xf4 0x40 0xf8 0x21 0xfc 0x21
				      0x100 0x21 0x104 0x21 0x108 0x21>;
	};
	wifi_uart_config: wifi-uart-config {
		pinctrl-single,pins = <0x168 0 0x16c 0 0x170 0>;
	};
};

/* status = "disabled" in the live DT of this wifi-only board (BAH2-W19): not reserved there */
&kerneldump { status = "disabled"; };
&tui_mem { status = "disabled"; };
&ivp { status = "disabled"; };
&modem_s { status = "disabled"; };
&modem_share_mem { status = "disabled"; };
&modem_socp { status = "disabled"; };
&modem_log { status = "disabled"; };
&xmode_data { status = "disabled"; };

&usb_phy {
	status = "ok";
	/* agassi2 values; bach2 stock values not yet extracted */
	hisilicon,eye-pattern = <0x059066DB>;
	hisilicon,host-eye-pattern = <0x059066DB>;
};

&usb {
	status = "ok";
};

/* Bring-up: every plain reboot or panic goes to fastboot (vendor reason 0x01), so the host can restore the stock kernel. */
&reboot {
	hisilicon,default-reboot-reason = <0x01>;
};
