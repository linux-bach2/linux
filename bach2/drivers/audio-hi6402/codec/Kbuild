# Vendor HI6402 codec stack (bach2 4.4 tree: sound/soc/codecs/hisi/hi6402.c, drivers/hisi/hi64xx),
# out of tree on 7.0 (docs/mainline-audio-port.md). Three modules, load order:
# hi_cdc_ctrl (register bus over SLIMbus), hi64xx_irq (codec IRQ domain), hi6402_codec (ASoC).
A := $(src)/..
ccflags-y += -I$(A)/compat -I$(A)/slimbus -I$(A)/slimbus/vendor/candance -I$(src)
ccflags-y += -include $(A)/compat/bach2_compat.h -include $(A)/compat/bach2_asoc_compat.h
obj-m += hi_cdc_ctrl.o hi64xx_irq.o hi6402_codec.o
hi64xx_irq-y := hi64xx_irq_main.o bach2_irq_stubs.o
hi_cdc_ctrl-y := hi_cdc_ctrl_main.o bach2_ssi_stubs.o
hi6402_codec-y := hi6402.o hi64xx_utils.o hi64xx_resmgr.o hi64xx_compat.o bach2_codec_stubs.o
